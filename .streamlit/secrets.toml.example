# Sao chép file này thành .streamlit/secrets.toml (chạy trên máy)
# hoặc dán nội dung vào mục Secrets của app trên Streamlit Community Cloud.
# KHÔNG đưa secrets.toml lên GitHub.

# Mật khẩu vào Trang Quản trị — đổi thành mật khẩu riêng của nhóm.
admin_password = "doi-mat-khau-nay"

# Nơi lưu nhật ký:
#   "csv"    -> file logs/nhat_ky.csv trên máy (chỉ dùng khi chạy trên máy)
#   "sheets" -> Google Sheets (bắt buộc khi triển khai trên Streamlit Cloud,
#               vì file ghi trên máy chủ có thể mất khi app khởi động lại)
log_backend = "csv"

# --- Chỉ cần khi log_backend = "sheets" ---
# URL của Google Sheet (chia sẻ quyền Editor cho email của service account bên dưới)
# sheet_url = "https://docs.google.com/spreadsheets/d/....../edit"
#
# Khóa JSON của Google service account (Google Cloud Console > IAM > Service Accounts > Keys)
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
